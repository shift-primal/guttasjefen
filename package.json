{
	"name": "guttasjefen",
	"private": true,
	"packageManager": "pnpm@12.6.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm db:up && pnpm db:migrate && pnpm -r --parallel dev",
		"bot": "pnpm --filter @guttasjefen/bot start",
		"web": "pnpm --filter @guttasjefen/web dev",
		"register:commands": "pnpm --filter @guttasjefen/bot register:commands",
		"test:prompt": "pnpm --filter @guttasjefen/bot test:prompt",
		"distill:taste": "pnpm --filter @guttasjefen/bot distill:taste",
		"db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
		"db:generate": "pnpm --filter @guttasjefen/db generate",
		"db:migrate": "pnpm --filter @guttasjefen/db migrate",
		"db:push": "pnpm --filter @guttasjefen/db push",
		"db:studio": "pnpm --filter @guttasjefen/db studio",
		"typecheck": "pnpm -r typecheck",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.6.0",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14"
	}
}
