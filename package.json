{
	"name": "guttasjefen",
	"version": "1.0.0",
	"description": "discord bot",
	"main": "src/index.ts",
	"packageManager": "pnpm@12.6.0",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"start": "tsx src/index.ts",
		"register:commands": "tsx src/register-commands.ts",
		"test:prompt": "tsx scripts/test-prompt.ts",
		"deploy:vps": "bash scripts/deploy.sh",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src",
		"format": "biome check --write src"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.6.0",
			"onFail": "download"
		}
	},
	"dependencies": {
		"@ai-sdk/xai": "^5.0.10",
		"@discord-player/extractor": "^7.2.0",
		"@discordjs/opus": "^0.10.0",
		"@snazzah/davey": "^0.1.12",
		"ai": "^7.0.116",
		"bgutils-js": "^4.0.3",
		"discord-player": "^7.2.0",
		"discord-player-youtubei": "^3.1.0",
		"discord.js": "^14.27.0",
		"dotenv": "^18.0.4",
		"googlevideo": "^4.1.1",
		"mediaplex": "^1.0.0",
		"simple-ytdl-core": "^1.1.1",
		"tsx": "^4.23.13",
		"youtube-dl-exec": "^3.1.15",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^26.6.2",
		"typescript": "^7.0.2"
	}
}
